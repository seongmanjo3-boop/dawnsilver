  const handleRequest = () => {
    const amt = Number(amount);
    if (!amt || amt < 1000) return showToast("1,000원 이상 금액을 입력해주세요.");
    if (!message.trim()) return showToast("입금 내용을 입력해주세요.");
    addRequest({ userId:user.id, userName:user.name, amount:amt, message:message.trim() });
    setAmount(""); setMessage("");
    showToast("후원금 등록 요청을 제출했습니다.");
  };

  return (
    <div className="page">
      <div className="my-wrap">
        {/* 헤더 */}
        <div className="my-header">
          <div className="my-avatar">{user.name[0]}</div>
          <div>
            <div className="my-name">{user.name}</div>
            <div className="my-email">{user.email}</div>
            <span className="grade-badge" style={{background:gradeBg(user.grade),color:gradeColor(user.grade)}}>{user.grade}</span>
          </div>
        </div>

        {/* 탭 */}
        <div className="my-tabs">
          {[["info","내 정보"],["donation","후원금 등록 요청"],["history","요청 내역"]].map(([k,l])=>(
            <button key={k} className={`my-tab${tab===k?" active":""}`} onClick={()=>setTab(k)}>{l}
              {k==="history"&&myReqs.some(r=>r.status!=="pending")&&<span style={{fontSize:".65rem",marginLeft:4,color:"var(--silver)"}}>({myReqs.length})</span>}
            </button>
          ))}
        </div>

        {/* 내 정보 */}
        {tab==="info" && (
          <>
            <div className="my-card">
              <div className="my-card-ttl">후원 현황</div>
              <span className="donation-amount">{fmt(user.donation)}</span>
              <span style={{fontSize:".85rem",color:"var(--muted)",marginLeft:4}}>원 / 월</span>
              <p style={{fontSize:".82rem",color:"var(--muted)",marginTop:10,lineHeight:1.7}}>
                월 1,000원 이상 3개월 이상 후원 시 후원회원 자격이 부여됩니다.<br/>
                후원금 변경은 <strong style={{color:"var(--navy)"}}>후원금 등록 요청</strong> 탭에서 신청하세요.
              </p>
            </div>
            <div className="my-card">
              <div className="my-card-ttl">가입 정보</div>
              <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:16,fontSize:".87rem"}}>
                <div><span style={{color:"var(--muted)"}}>가입일</span><br/><strong>{user.joined}</strong></div>
                <div><span style={{color:"var(--muted)"}}>회원 상태</span><br/><strong style={{color:"#1e6e4a"}}>활성</strong></div>
              </div>
            </div>
            <div className="my-card" style={{background:"rgba(13,32,59,.02)"}}>
              <div className="my-card-ttl">오픈채팅 참여</div>
              <p style={{fontSize:".85rem",color:"var(--muted)",marginBottom:16}}>카카오톡 오픈채팅방에서 새벽의 은빛 멤버들과 소통하세요.</p>
              <a href={KAKAO_URL} target="_blank" rel="noreferrer" className="btn-p" style={{textDecoration:"none",display:"inline-block"}}>💬 오픈채팅 바로가기</a>
            </div>
          </>
        )}

        {/* 후원금 등록 요청 */}
        {tab==="donation" && (
          <>
            {/* 카카오 안내 박스 */}
            <a href={KAKAO_URL} target="_blank" rel="noreferrer" className="kakao-box">
              <span className="kakao-icon">💬</span>
              <div>
                <div className="kakao-ttl">카카오톡 오픈채팅방에서 입금 내역 캡처 보내기</div>
                <div className="kakao-sub">먼저 오픈채팅방에 입금 내역 캡처 이미지를 보내주세요 → 클릭하면 채팅방으로 이동합니다</div>
              </div>
              <span style={{marginLeft:"auto",fontSize:"1.2rem",flexShrink:0}}>→</span>
            </a>

            {/* 안내 */}
            <div className="don-guide">
              <div className="don-guide-ttl">📌 후원금 등록 방법</div>
              <div className="don-guide-steps">
                <div className="don-guide-step"><span className="don-step-num">1</span><span>위 버튼을 눌러 <strong>카카오톡 오픈채팅방</strong>으로 이동합니다.</span></div>
                <div className="don-guide-step"><span className="don-step-num">2</span><span>채팅방에 <strong>입금 내역 캡처 이미지</strong>를 보내주세요.</span></div>
                <div className="don-guide-step"><span className="don-step-num">3</span><span>아래 양식에 <strong>입금 금액과 메시지</strong>를 입력하고 요청을 제출합니다.</span></div>
                <div className="don-guide-step"><span className="don-step-num">4</span><span>관리자가 확인 후 <strong>승인</strong>하면 후원금이 등록됩니다.</span></div>
              </div>
              <div className="info-box">💡 캡처 이미지 전송과 아래 요청 제출을 <strong>모두</strong> 완료해야 정상 처리됩니다.</div>
            </div>

            {/* 요청 폼 */}
            <div className="don-req-form">
              <div className="don-req-ttl">후원금 등록 요청서</div>
              <div className="field"><label>입금 금액 (원)</label><input type="number" value={amount} onChange={e=>setAmount(e.target.value)} placeholder="예: 5000" min="1000" step="1000"/></div>
              <div className="field"><label>입금 메시지 / 확인 내용</label><textarea style={{minHeight:80,resize:"vertical"}} value={message} onChange={e=>setMessage(e.target.value)} placeholder="예) 6월 후원금 5,000원 입금했습니다. 이름: 홍길동"/></div>
              <button className="btn-p" onClick={handleRequest}>요청 제출하기</button>
            </div>
          </>
        )}

        {/* 요청 내역 */}
        {tab==="history" && (
          <div>
            <p style={{fontSize:".85rem",color:"var(--muted)",marginBottom:20,lineHeight:1.7}}>제출한 후원금 등록 요청 내역입니다. 관리자 검토 후 상태가 업데이트됩니다.</p>
            {myReqs.length===0 ? (
              <div className="empty"><div className="empty-icon">📭</div>아직 제출한 요청이 없습니다.<br/><span style={{fontSize:".8rem"}}>'후원금 등록 요청' 탭에서 신청해보세요.</span></div>
            ) : (
              <div className="don-history">
                {myReqs.map(r=>(
                  <div className="don-hist-item" key={r.id}>
                    <div className="don-hist-info">
                      <span className="don-hist-amt">{fmt(r.amount)}원 / 월</span>
                      <span className="don-hist-msg">{r.message}</span>
                      <span className="don-hist-date">{r.date}</span>
                    </div>
                    <span className="status-badge" style={{background:sBg(r.status),color:sColor(r.status)}}>{sLabel(r.status)}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}
      </div>
    </div>
  );
}

/* ── ADMIN ──────────────────────────────────────────────── */
function Admin({ setPage }) {
  const { user, users, notices, requests, updateUser, deleteUser, addNotice, deleteNotice, reviewRequest, showToast } = useApp();
  const [tab, setTab] = useState("requests");
  const [localUsers, setLocalUsers] = useState([]);
  const [nTitle, setNTitle] = useState("");
  const [nContent, setNContent] = useState("");
  const [nPinned, setNPinned] = useState(false);

  useEffect(()=>{
    setLocalUsers(users.map(u=>({...u,_grade:u.grade,_donation:u.donation})));
  },[users]);

  if (!user || !ADMIN_GRADES.includes(user.grade)) { setPage("home"); return null; }

  const pendingReqs = requests.filter(r=>r.status==="pending").sort((a,b)=>b.id-a.id);
  const allReqs     = [...requests].sort((a,b)=>b.id-a.id);

  const setLU = (id,k,v) => setLocalUsers(lu=>lu.map(u=>u.id===id?{...u,[k]:v}:u));

  const applyUser = (id) => {
    const lu = localUsers.find(u=>u.id===id);
    updateUser(id,{grade:lu._grade,donation:Number(lu._donation)});
    showToast("저장되었습니다.");
  };

  const handleDelete = (id) => {
    if (id===user.id) return showToast("자신의 계정은 탈퇴 처리할 수 없습니다.");
    if (!window.confirm("정말 탈퇴 처리하시겠습니까?")) return;
    deleteUser(id);
    showToast("탈퇴 처리되었습니다.");
  };

  const handleReview = (id, action) => {
    reviewRequest(id, action);
    showToast(action==="approved" ? "✅ 승인되었습니다." : "❌ 거부되었습니다.");
  };

  const handleNotice = () => {
    if (!nTitle.trim()||!nContent.trim()) return showToast("제목과 내용을 입력해주세요.");
    addNotice({title:nTitle,content:nContent,pinned:nPinned,author:user.name,date:today()});
    setNTitle(""); setNContent(""); setNPinned(false);
    showToast("공지가 등록되었습니다.");
  };

  const tabList = [
    ["requests", pendingReqs.length>0 ? `후원 요청 (${pendingReqs.length})` : "후원 요청"],
    ["members","회원 관리"],
    ["notices","공지 관리"],
  ];

  return (
    <div className="page">
      <div className="admin-wrap">
        <div className="admin-ttl">관리자 페이지</div>
        <div className="admin-tabs">
          {tabList.map(([k,l])=>(
            <button key={k} className={`admin-tab${tab===k?" active":""}`} onClick={()=>setTab(k)}>
              {k==="requests"&&pendingReqs.length>0
                ? <span style={{color:"#c0392b",fontWeight:700}}>{l}</span>
                : l}
            </button>
          ))}
        </div>

        {/* 후원 요청 탭 */}
        {tab==="requests" && (
          <div>
            {pendingReqs.length>0 && (
              <>
                <p style={{fontFamily:"var(--serif)",fontSize:"1rem",fontWeight:700,color:"var(--navy)",marginBottom:14}}>검토 대기 중 ({pendingReqs.length}건)</p>
                {pendingReqs.map(r=>{
                  const targetUser = users.find(u=>u.id===r.userId);
                  return (
                    <div className="req-card pending" key={r.id}>
                      <div className="req-info">
                        <span className="req-name">{r.userName}</span>
                        <span className="req-amt">{fmt(r.amount)}원 / 월 요청</span>
                        {targetUser && <span style={{fontSize:".78rem",color:"var(--silver)"}}>현재 후원금: {fmt(targetUser.donation)}원</span>}
                        <span className="req-msg">{r.message}</span>
                        <span className="req-date">{r.date}</span>
                      </div>
                      <div className="req-acts">
                        <button className="btn-sm btn-sm-g" onClick={()=>handleReview(r.id,"approved")}>✅ 승인</button>
                        <button className="btn-sm btn-sm-r" onClick={()=>handleReview(r.id,"rejected")}>❌ 거부</button>
                      </div>
                    </div>
                  );
                })}
                <div style={{margin:"28px 0",borderTop:"1px solid var(--border)"}}/>
              </>
            )}
            <p style={{fontFamily:"var(--serif)",fontSize:"1rem",fontWeight:700,color:"var(--navy)",marginBottom:14}}>전체 요청 내역</p>
            {allReqs.length===0
              ? <div className="empty"><div className="empty-icon">📭</div>제출된 요청이 없습니다.</div>
              : allReqs.map(r=>(
                <div className={`req-card ${r.status}`} key={r.id}>
                  <div className="req-info">
                    <span className="req-name">{r.userName}</span>
                    <span className="req-amt">{fmt(r.amount)}원 / 월</span>
                    <span className="req-msg">{r.message}</span>
                    <span className="req-date">{r.date}</span>
                  </div>
                  <span className="status-badge" style={{background:sBg(r.status),color:sColor(r.status)}}>{sLabel(r.status)}</span>
                </div>
              ))
            }
          </div>
        )}

        {/* 회원 관리 탭 */}
        {tab==="members" && (
          <div className="tbl-wrap">
            <table>
              <thead>
                <tr>
                  <th>이름</th><th>이메일</th><th>등급 조정</th><th>후원금 조정 (원/월)</th><th>가입일</th><th>저장</th><th>탈퇴</th>
                </tr>
              </thead>
              <tbody>
                {localUsers.map(u=>(
                  <tr key={u.id}>
                    <td><strong>{u.name}</strong></td>
                    <td style={{color:"var(--muted)",fontSize:".82rem"}}>{u.email}</td>
                    <td>
                      <select className="tbl-select" value={u._grade} onChange={e=>setLU(u.id,"_grade",e.target.value)}>
                        {GRADES.map(g=><option key={g} value={g}>{g}</option>)}
                      </select>
                    </td>
                    <td>
                      <div className="don-adj">
                        <input type="number" value={u._donation} onChange={e=>setLU(u.id,"_donation",e.target.value)} min="0" step="1000"/>
                        <span style={{fontSize:".78rem",color:"var(--muted)"}}>원</span>
                      </div>
                    </td>
                    <td style={{color:"var(--muted)",fontSize:".82rem"}}>{u.joined}</td>
                    <td><button className="btn-sm btn-sm-p" onClick={()=>applyUser(u.id)}>저장</button></td>
                    <td><button className="btn-sm btn-sm-r" onClick={()=>handleDelete(u.id)}>탈퇴</button></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {/* 공지 관리 탭 */}
        {tab==="notices" && (
          <>
            <div className="nf">
              <div className="nf-ttl">새 공지 작성</div>
              <input className="nf-input" placeholder="제목" value={nTitle} onChange={e=>setNTitle(e.target.value)}/>
              <textarea className="nf-textarea" placeholder="내용을 입력하세요" value={nContent} onChange={e=>setNContent(e.target.value)}/>
              <div className="nf-row">
                <label style={{display:"flex",alignItems:"center",gap:8,fontSize:".83rem",color:"var(--muted)",cursor:"pointer"}}>
                  <input type="checkbox" checked={nPinned} onChange={e=>setNPinned(e.target.checked)}/> 상단 고정
                </label>
                <button className="btn-p" style={{padding:"9px 24px",fontSize:".85rem"}} onClick={handleNotice}>등록</button>
              </div>
            </div>
            <div className="tbl-wrap">
              <table>
                <thead><tr><th>고정</th><th>제목</th><th>작성자</th><th>날짜</th><th>삭제</th></tr></thead>
                <tbody>
                  {[...notices].sort((a,b)=>b.id-a.id).map(n=>(
                    <tr key={n.id}>
                      <td>{n.pinned?<span style={{fontSize:".7rem",background:"var(--navy)",color:"#fff",padding:"3px 9px",borderRadius:20}}>고정</span>:"—"}</td>
                      <td><strong>{n.title}</strong></td>
                      <td style={{color:"var(--muted)",fontSize:".82rem"}}>{n.author}</td>
                      <td style={{color:"var(--muted)",fontSize:".82rem"}}>{n.date}</td>
                      <td><button className="btn-sm btn-sm-r" onClick={()=>{deleteNotice(n.id);showToast("삭제되었습니다.");}}>삭제</button></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )}
      </div>
    </div>
  );
}

/* ── APP ROOT ───────────────────────────────────────────── */
export default function App() {
  const [page, setPage]       = useState("home");
  const [user, setUser]       = useState(null);
  const [users, setUsers]     = useState(initUsers);
  const [notices, setNotices] = useState(initNotices);
  const [requests, setRequests] = useState(initRequests);
  const [toast, setToast]     = useState("");

  const showToast = (msg) => { setToast(msg); setTimeout(()=>setToast(""),2600); };

  const login = (email,pw) => {
    const u = users.find(u=>u.email===email&&u.password===pw&&u.active);
    if (u) { setUser(u); return true; } return false;
  };
  const logout = () => { setUser(null); setPage("home"); };
  const register = (name,email,password) => {
    if (users.find(u=>u.email===email)) return false;
    const nu = {id:Date.now(),name,email,password,grade:"일반회원",donation:0,joined:today(),active:true};
    setUsers(us=>[...us,nu]); setUser(nu); return true;
  };
  const updateUser = (id,changes) => {
    setUsers(us=>us.map(u=>u.id===id?{...u,...changes}:u));
    if (user?.id===id) setUser(u=>({...u,...changes}));
  };
  const deleteUser = (id) => {
    setUsers(us=>us.map(u=>u.id===id?{...u,active:false}:u));
    setLocalUsers && setLocalUsers(lu=>lu.filter(u=>u.id!==id));
  };
  const addNotice = (n) => setNotices(ns=>[...ns,{...n,id:Date.now()}]);
  const deleteNotice = (id) => setNotices(ns=>ns.filter(n=>n.id!==id));
  const addRequest = (r) => setRequests(rs=>[...rs,{...r,id:Date.now(),status:"pending",date:today()}]);
  const reviewRequest = (id, status) => {
    // 승인 시 해당 회원의 후원금도 자동 업데이트
    if (status==="approved") {
      const req = requests.find(r=>r.id===id);
      if (req) updateUser(req.userId, {donation:req.amount});
    }
    setRequests(rs=>rs.map(r=>r.id===id?{...r,status}:r));
  };

  // 로그인 없이 보호된 페이지 접근 시 회원가입으로
  const goPage = (p) => {
    const protected_ = ["mypage","admin"];
    if (protected_.includes(p) && !user) { setPage("signup"); return; }
    setPage(p);
  };

  const ctx = { user, users:users.filter(u=>u.active), notices, requests, login, logout, register, updateUser, deleteUser, addNotice, deleteNotice, addRequest, reviewRequest, showToast };

  const pages = {
    home:   <Home   setPage={goPage}/>,
    login:  <Login  setPage={setPage}/>,
    signup: <Signup setPage={setPage}/>,
    mypage: <MyPage setPage={goPage}/>,
    admin:  <Admin  setPage={goPage}/>,
  };

  return (
    <AppCtx.Provider value={ctx}>
      <style>{css}</style>
      <Nav setPage={goPage}/>
      {pages[page] ?? <Home setPage={goPage}/>}
      <Toast msg={toast}/>
    </AppCtx.Provider>
  );
}
