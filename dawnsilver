/* ── LOGIN ──────────────────────────────────────────────── */
function Login({ setPage }) {
  const { login } = useApp();
  const [email,setEmail] = useState("");
  const [pw,setPw] = useState("");
  const [err,setErr] = useState("");
  const handle = () => {
    if (!login(email,pw)) setErr("이메일 또는 비밀번호를 확인해주세요.");
    else setPage("mypage");
  };
  return (
    <div className="page"><div className="auth-wrap">
      <div className="auth-box">
        <div className="auth-ttl">로그인</div>
        <div className="auth-sub">새벽의 은빛 계정으로 로그인하세요.</div>
        {err && <div className="auth-err">{err}</div>}
        <div className="field"><label>이메일</label><input type="email" value={email} onChange={e=>setEmail(e.target.value)} onKeyDown={e=>e.key==="Enter"&&handle()} placeholder="email@example.com"/></div>
        <div className="field"><label>비밀번호</label><input type="password" value={pw} onChange={e=>setPw(e.target.value)} onKeyDown={e=>e.key==="Enter"&&handle()} placeholder="비밀번호 입력"/></div>
        <button className="btn-p" style={{width:"100%",marginTop:8}} onClick={handle}>로그인</button>
        <div className="auth-switch">계정이 없으신가요? <span onClick={()=>setPage("signup")}>회원가입</span></div>
      </div>
    </div></div>
  );
}

/* ── SIGNUP ─────────────────────────────────────────────── */
function Signup({ setPage }) {
  const { register } = useApp();
  const [f,setF] = useState({name:"",email:"",password:"",password2:""});
  const [err,setErr] = useState("");
  const set = (k,v) => setF(p=>({...p,[k]:v}));
  const handle = () => {
    if (!f.name||!f.email||!f.password) return setErr("모든 항목을 입력해주세요.");
    if (f.password!==f.password2) return setErr("비밀번호가 일치하지 않습니다.");
    if (f.password.length<8) return setErr("비밀번호는 8자 이상이어야 합니다.");
    if (!register(f.name,f.email,f.password)) return setErr("이미 사용 중인 이메일입니다.");
    setPage("mypage");
  };
  return (
    <div className="page"><div className="auth-wrap">
      <div className="auth-box">
        <div className="auth-ttl">회원가입</div>
        <div className="auth-sub">새벽의 은빛에 오신 것을 환영합니다.</div>
        {err && <div className="auth-err">{err}</div>}
        <div className="field"><label>이름</label><input value={f.name} onChange={e=>set("name",e.target.value)} placeholder="이름 또는 닉네임"/></div>
        <div className="field"><label>이메일</label><input type="email" value={f.email} onChange={e=>set("email",e.target.value)} placeholder="email@example.com"/></div>
        <div className="field"><label>비밀번호</label><input type="password" value={f.password} onChange={e=>set("password",e.target.value)} placeholder="8자 이상"/></div>
        <div className="field"><label>비밀번호 확인</label><input type="password" value={f.password2} onChange={e=>set("password2",e.target.value)} onKeyDown={e=>e.key==="Enter"&&handle()} placeholder="비밀번호 재입력"/></div>
        <button className="btn-p" style={{width:"100%",marginTop:8}} onClick={handle}>가입하기</button>
        <div className="auth-switch">이미 계정이 있으신가요? <span onClick={()=>setPage("login")}>로그인</span></div>
      </div>
    </div></div>
  );
}

