/* ── 소형 컴포넌트 ───────────────────────────────────────── */
function Toast({ msg }) {
  return msg ? <div className="toast">{msg}</div> : null;
}

function Modal({ notice, onClose }) {
  if (!notice) return null;
  return (
    <div className="overlay" onClick={onClose}>
      <div className="modal" onClick={e=>e.stopPropagation()}>
        <div className="modal-ttl">{notice.title}</div>
        <div className="modal-date">{notice.author} · {notice.date}</div>
        <div className="modal-body">{notice.content}</div>
        <div style={{marginTop:24}}>
          <button className="btn-o" style={{padding:"9px 24px",fontSize:".85rem"}} onClick={onClose}>닫기</button>
        </div>
      </div>
    </div>
  );
}

