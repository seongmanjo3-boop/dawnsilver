/* DONATION BANNER (홈) */
.don-banner{background:linear-gradient(135deg,#0d203b 0%,#1e4068 100%);padding:72px 0}
.don-banner-inner{max-width:1060px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
